# Pokemon TCG API key (optional - increases rate limits)
# Get your key at: https://dev.pokemontcg.io/
POKEMON_TCG_API_KEY=

# Flask settings
FLASK_SECRET_KEY=change-me-in-production
FLASK_DEBUG=false

# Database – choose one:
# SQLite (default, no setup needed)
DATABASE_PATH=packbot.db
# PostgreSQL (set DATABASE_URL to enable; DATABASE_PATH is ignored when set)
DATABASE_URL=

# Session settings
# How long a session token stays valid (default: 30 days)
SESSION_DURATION_DAYS=30

# Email / SMTP settings (all optional – leave SMTP_HOST blank to disable)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Packbot <noreply@example.com>
# Base URL used in email links (e.g. https://packbot.example.com)
APP_BASE_URL=
